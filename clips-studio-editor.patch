new file mode 100644
index 0000000..f55cb66
--- /dev/null
+++ b/tests/test_editor_import.py
@@ -0,0 +1,77 @@
+"""Full source imports use the editor's existing render and caption paths."""
+
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from core import pipeline
+from core.modes import probe_size
+from longform.process import process_longform
+from server.jobs import Worker
+
+VIDEO_ID = "local_import"
+
+
+@pytest.mark.parametrize(("landscape", "size"), [(False, (1080, 1920)), (True, (1920, 1080))])
+def test_import_and_trim_full_source(db, tmp_path, landscape, size):
+    ffmpeg = shutil.which("ffmpeg")
+    if not ffmpeg or not shutil.which("ffprobe"):
+        pytest.skip("FFmpeg and FFprobe are required for the render")
+    filters = subprocess.run([ffmpeg, "-filters"], capture_output=True, text=True, check=True)
+    if "subtitles" not in filters.stdout:
+        pytest.skip("The render requires FFmpeg with libass")
+
+    source = tmp_path / "downloads" / f"{VIDEO_ID}.mp4"
+    source.parent.mkdir()
+    subprocess.run([
+        ffmpeg, "-v", "error", "-f", "lavfi", "-i", "color=c=blue:s=180x320:r=24",
+        "-f", "lavfi", "-i", "sine=frequency=400", "-t", "2", "-c:v", "libx264",
+        "-pix_fmt", "yuv420p", "-threads", "1", "-c:a", "aac", str(source),
+    ], check=True)
+    transcript = tmp_path / "transcripts" / f"{VIDEO_ID}.json"
+    transcript.parent.mkdir()
+    transcript.write_text(json.dumps({
+        "language": "en",
+        "segments": [{
+            "start": 0.6, "end": 1.2, "text": "Full source",
+            "words": [{"start": 0.6, "end": 0.85, "word": "Full"},
+                      {"start": 0.85, "end": 1.2, "word": "source"}],
+        }],
+    }), encoding="utf-8")
+
+    config = {
+        "paths": {"data_dir": str(tmp_path)},
+        "clips": {
+            "captions": True, "vertical_live": not landscape, "outro": False,
+            "caption_style": {"words_per_caption": 2}, "min_score": 1000,
+            "pipeline": {"id": "retired/finder"},
+        },
+        "whisper": {"model": "tiny", "device": "cpu"},
+    }
+    db.upsert_video(VIDEO_ID, title="Test import")
+    if landscape:
+        process_longform(f"local:{VIDEO_ID}", config, db, {"mode": "highlights"})
+    else:
+        pipeline.process_video(f"local:{VIDEO_ID}", config, db)
+
+    clip, = db.clips_for_video(VIDEO_ID)
+    assert clip["start_s"] == pytest.approx(0, abs=0.02)
+    assert clip["end_s"] == pytest.approx(2, abs=0.02)
+    opts = json.loads(clip["render_opts"])
+    assert opts["imported"]
+    assert bool(opts.get("profile")) == landscape
+    assert opts["caption_style"]["words_per_caption"] == 2
+    path = Path(clip["path"])
+    assert probe_size(path) == size
+    assert pipeline._whole_duration(path) == pytest.approx(2, abs=0.15)
+
