@@ -266,6 +266,20 @@ def cached_source(downloads: Path, video_id: str | None) -> Path | None:
     return None
 
 
+def editor_source(downloads: Path, video_id: str, render_opts: dict) -> Path | None:
+    from sources.vertical import SUFFIX
+
+    if "source_vertical" in render_opts:
+        source_id = f"{video_id}{SUFFIX}" if render_opts["source_vertical"] else video_id
+        return cached_source(downloads, source_id)
+    if render_opts.get("vertical_live"):
+        # Clips saved before their source variant was recorded.
+        vertical = cached_source(downloads, f"{video_id}{SUFFIX}")
+        if vertical is not None:
+            return vertical
+    return cached_source(downloads, video_id)
+
+
 def discard(path: Path | None) -> bool:
     """Delete a scratch file, and never raise. Returns True if it is gone.
 
